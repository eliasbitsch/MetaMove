[STYLESHEET]
name = MetaMove
description = Sphinx base with hyphenation disabled and ragged-right body text
base = sphinx

# No hyphenation anywhere, and left-align (ragged right) body text so there are
# no mid-word breaks and no gappy justification.

[default:Paragraph]
hyphenate = False
text_align = LEFT

[body]
hyphenate = False
text_align = LEFT

# Keep code blocks / ASCII data-flow diagrams together: if a block would be
# split with fewer than this many lines on the current page, push the whole
# block to the next page instead. Our longest block is 27 lines; a page holds
# ~45+, so this never loops on an over-long block (it splits normally then).
[code block]
split_minimum_lines = 30

[title]
hyphenate = False

[heading level 1]
hyphenate = False

[heading level 2]
hyphenate = False

[heading level 3]
hyphenate = False

[heading level 4]
hyphenate = False

[title page title]
hyphenate = False

[title page subtitle]
hyphenate = False

[title page author]
hyphenate = False

[header]
hyphenate = False

[footer]
hyphenate = False

[body matter chapter title]
hyphenate = False

[front matter section title]
hyphenate = False
